<% layout('layouts/boilerplate') %>

<div class="magic-error-wrap">
  <p class="magic-error-code magic-gradient-text"><%= err.statusCode %></p>
  <h1 style="font-weight: 800; font-size: 1.8rem;">Oops! Something went wrong</h1>
  <p class="lead text-muted mt-2"><%= err.message %></p>
  <a href="/listings" class="magic-shimmer-btn mt-3">
    <i class="fa-solid fa-compass"></i> Back to Listings
  </a>
</div>