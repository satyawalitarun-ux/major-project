<% layout("layouts/boilerplate") %>
    <h3>All Listings</h3>  
 <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1"> 
     <% for(let listing of Listings) { %>
        <a href="/listings/<%=listing._id%>" class="list-link">
        <div class="card col" style="width: 20rem;">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image url" style="height: 20rem"/> 
  <div class="card-body">
    <p class="card-text">
        <b>  <%=listing.title %> </b>
    </br>
        &#8377; <%= listing.price.toLocaleString("en-in") %>/night
    </p>
  </div>
</div>
     <% } %>
</div>