<% layout("layouts/boilerplate") %>

<div class="container listing-details">

  <div class="listing-card magic-beam magic-blur-fade">

<div class="listing-image">
  <img
    src="<%= listing.image %>"
    alt="<%= listing.title %>"
  />
</div>

<div class="listing-content">

  <span class="magic-badge"><span class="dot"></span> Featured Listing</span>

  <h1><%= listing.title %></h1>

  <p class="listing-location">
    📍 <%= listing.location %>, <%= listing.country %>
  </p>

  <hr />

  <h5>Description</h5>
  <p class="listing-description">
    <%= listing.description %>
  </p>

  <div class="price-box">
    <span class="price">
      &#8377; <%= listing.price.toLocaleString("en-IN") %>
    </span>
    <span class="per-night"> / night</span>
  </div>

  <div class="listing-actions">

    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn edit-btn magic-shimmer-btn"
    >
      <i class="fa-solid fa-pen-to-square"></i> Edit Listing
    </a>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=DELETE"
      onsubmit="return confirm('Are you sure you want to delete this listing?');"
    >
      <button type="submit" class="btn delete-btn magic-ghost-btn magic-ghost-danger">
        <i class="fa-solid fa-trash-can"></i> Delete Listing
      </button>
    </form>

  </div>

</div>
<div class="row">
  <div class="col-lg-8 offset-lg-2">
    <div class="magic-form-card magic-blur-fade" style="padding: 1.8rem;">
      <h5 style="font-weight: 800;">Leave a <span class="magic-gradient-text">Review</span></h5>
  <form action="/listings/<%= listing._id %>/reviews" method="POST" >
    <div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating</label>
      <input
        type="range"
        id="rating"
        name="review[rating]"
        class="magic-rating"
        min="1"
        max="5"
        required/>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            class="form-control magic-input"
            id="comment"
            name="review[comment]"
            rows="5"
            col="50"
            required
          ></textarea>
        </div>
     <button type="submit" class="magic-shimmer-btn magic-shimmer-btn-sm">Submit</button>
  </form>
    </div>
  </div>
</div>
 <hr />

<h4 class="mt-5 mb-4" style="font-weight: 800;">
    All <span class="magic-gradient-text">Reviews</span>
</h4>

<div class="row g-4 magic-blur-fade">
    <% for(review of listing.reviews) { %>
        <div class="col-lg-5 magic-review-card magic-spotlight">
            <div class="d-flex align-items-center gap-3 mb-2">
                <span class="magic-review-avatar">J</span>
                <div>
                    <h5 class="mb-0" style="font-weight: 700; font-size: 1rem;">Jane Doe</h5>
                    <span class="magic-stars"><% for(let i = 0; i < review.rating; i++) { %>★<% } %><% for(let i = review.rating; i < 5; i++) { %>☆<% } %></span>
                </div>
            </div>
            <p class="card-text mb-3"><%= review.comment %></p>

            <form
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            >
                <button class="magic-ghost-btn magic-ghost-danger" style="padding: 0.35rem 0.9rem; font-size: 0.8rem;">Delete</button>
            </form>
        </div>
    <% } %>
</div>
</div>
