<% layout("layouts/boilerplate") %>

<div class="magic-auth-wrap">
  <div class="magic-auth-card magic-blur-fade magic-spotlight">
    <div class="magic-dots"></div>

    <h1 class="magic-auth-title">Join the <span class="magic-gradient-text">journey</span></h1>
    <p class="magic-auth-sub">Create an account and start exploring ✨</p>

    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <!-- Username -->
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input id="username" name="username" type="text" class="form-control magic-input" required />
        <div class="invalid-feedback">Please provide a valid username.</div>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" class="form-control magic-input" required />
        <div class="invalid-feedback">Please provide a valid email.</div>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control magic-input" required />
        <div class="invalid-feedback">Please provide a password.</div>
      </div>

      <button type="submit" class="magic-shimmer-btn w-100 mt-2">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Sign Up
      </button>
    </form>

    <p class="magic-auth-swap">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>